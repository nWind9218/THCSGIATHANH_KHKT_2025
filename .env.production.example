# Production Environment Variables for Railway (Facebook Messenger + Mimi v2)

# ============================================
# Server Configuration
# ============================================
ENVIRONMENT=production
PORT=8000
LOG_LEVEL=info
# Chỉ dùng khi chạy `python -m api.main` (Railway chạy uvicorn qua Dockerfile với PORT nên có thể bỏ qua):
# API_HOST (mặc định 0.0.0.0), API_PORT (mặc định 8000), API_RELOAD (mặc định false; không bật ở production)

# ============================================
# Facebook Messenger
# ============================================
VERIFY_TOKEN=your-webhook-verify-token
PAGE_ACCESS_TOKEN=your-page-access-token
# Webhook signature check. When empty every request is accepted, so always set it in production.
FACEBOOK_APP_SECRET=your-app-secret
# Comma-separated list of Facebook PSIDs authorized to use #accept and #resume
ADMIN_FACEBOOK_PSIDS=123456789,987654321
# Phiên bản Graph API khi gửi tin nhắn (mặc định v20.0)
FACEBOOK_GRAPH_API_VERSION=v20.0

# ============================================
# Mimi v2 model
# ============================================
# Production dùng OpenAI trực tiếp với OPENAI_API_KEY (mục OpenAI bên dưới): KHÔNG đặt 3 biến này.
# Chỉ bỏ comment khi muốn chuyển sang Shineshop (OpenAI-compatible); key OpenAI không bao giờ bị gửi tới đó.
# Allowed hosts: https://api.openai.com/v1 (default) and https://api.shineshop.dev/v1
# MIMI_V2_BASE_URL=https://api.shineshop.dev/v1
# MIMI_V2_API_KEY=your-shineshop-key
# MIMI_V2_MODEL=gpt-5.6-luna

# --- Mimi v2: tham số model (tuỳ chọn) ---
# API dùng để gọi model (mặc định responses): responses | chat_completions
MIMI_V2_API=responses
# Mức suy luận chung (mặc định: để trống = dùng mặc định của model). none|minimal|low|medium|high|xhigh tuỳ model
MIMI_V2_REASONING_EFFORT=
# Độ dài câu trả lời (mặc định: để trống). low|medium|high, chỉ một số model hỗ trợ
MIMI_V2_VERBOSITY=
# Số token tối đa mỗi lần gọi model (mặc định 2048)
MIMI_V2_MAX_OUTPUT_TOKENS=2048
# Timeout mỗi lần gọi model, giây (mặc định 60). Production từ chối giá trị > 60
MIMI_V2_TIMEOUT=60

# --- Mimi v2: định tuyến thích ứng (production nên dùng adaptive) ---
# Chọn model + mức suy luận theo từng luồng, dùng chung endpoint/key ở trên (mặc định: tắt = một model duy nhất)
# safety gpt-5.4-mini/low (không chắc -> kiểm tra lại 1 lần ở medium), assessment gpt-5.4-mini/none,
# reply gpt-5.4-mini/low (none cho listen/closing). Lỗi tạm thời -> thử lại 1 lần bằng model dự phòng.
# Trên Shineshop hãy đặt MIMI_V2_MODEL_* thành model endpoint đó có (ví dụ gpt-5.6-luna).
MIMI_V2_ROUTING=adaptive
# Ghi đè model theo luồng (mặc định gpt-5.4-mini cho cả ba, đúng với OpenAI nên để trống)
# MIMI_V2_MODEL_SAFETY=gpt-5.4-mini
# MIMI_V2_MODEL_ASSESSMENT=gpt-5.4-mini
# MIMI_V2_MODEL_REPLY=gpt-5.4-mini
# Ghi đè mức suy luận theo luồng (mặc định safety=low, assessment=none, reply=low)
MIMI_V2_EFFORT_SAFETY=low
MIMI_V2_EFFORT_ASSESSMENT=none
MIMI_V2_EFFORT_REPLY=low
# Model dự phòng khi lỗi tạm thời (mặc định gpt-5-mini; đặt "off" để tắt dự phòng)
MIMI_V2_FALLBACK_MODEL=gpt-5-mini
# Mức suy luận của model dự phòng (mặc định low)
MIMI_V2_FALLBACK_EFFORT=low

# ============================================
# OpenAI (embeddings and default model provider)
# ============================================
OPENAI_API_KEY=sk-proj-xxxxx
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: use separate key for embedding if needed
OPENAI_API_EMBEDDING_KEY=

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string (Supabase Postgres URI)
DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_DB_URL=postgresql://user:password@supabase-host/postgres

# ============================================
# Redis Configuration
# ============================================
# Redis connection string (Upstash Redis URI - TLS recommended)
REDIS_URL=rediss://default:password@host:port
UPSTASH_REDIS_URL=rediss://default:password@host:port

# ============================================
# Email Configuration (human handoff notification)
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Sender must be a verified domain/sender on Resend
RESEND_FROM_EMAIL=Mimi Bot <noreply@yourdomain.com>
# Optional: override endpoint for proxy/self-host test
RESEND_API_BASE_URL=https://api.resend.com
# Optional: API timeout (seconds)
RESEND_REQUEST_TIMEOUT=15
EMERGENCY_EMAIL_RECIPIENTS=teacher1@gmail.com,teacher2@gmail.com
# Enable Resend diagnostics logs (request/response steps)
RESEND_DIAG=true

# ============================================
# Teacher Console (https://<your-domain>/console)
# ============================================
# The console stays disabled (HTTP 503) until ALL THREE of these are set.
CONSOLE_ADMIN_USERNAME=giaovien
# Tạo bằng: python scripts/hash_console_password.py (nhập mật khẩu, dán dòng kết quả vào đây)
CONSOLE_ADMIN_PASSWORD_HASH=pbkdf2_sha256$390000$salt_base64$hash_base64
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự để ký cookie đăng nhập (ngắn hơn thì console bị tắt), ví dụ: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONSOLE_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Cookie đăng nhập chỉ gửi qua HTTPS (mặc định true). Giữ true trên production HTTPS; chỉ đặt false khi chạy local http://
CONSOLE_COOKIE_SECURE=true
# Mặc định false. Chỉ ảnh hưởng IP dùng để giới hạn đăng nhập sai (không ảnh hưởng scheme/cookie).
# Đặt true khi chạy sau proxy của Railway: lấy IP từ hop cuối của X-Forwarded-For; nếu để false mọi người dùng chung 1 IP proxy.
# Không đặt true khi server mở trực tiếp ra internet (client có thể giả header).
CONSOLE_TRUST_PROXY=true
# Facebook App ID: lets the console record replies sent by humans from Page Inbox (echo events)
FACEBOOK_APP_ID=
