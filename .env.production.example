# Production Environment Variables for Railway (Facebook Messenger + Mimi v2)

# ============================================
# Server Configuration
# ============================================
ENVIRONMENT=production
PORT=8000
LOG_LEVEL=info

# ============================================
# Facebook Messenger
# ============================================
VERIFY_TOKEN=your-webhook-verify-token
PAGE_ACCESS_TOKEN=your-page-access-token
# Webhook signature check. When empty every request is accepted, so always set it in production.
FACEBOOK_APP_SECRET=your-app-secret
# Comma-separated list of Facebook PSIDs authorized to use #accept and #resume
ADMIN_FACEBOOK_PSIDS=123456789,987654321

# ============================================
# Mimi v2 model
# ============================================
# Default provider is OpenAI. To use Shineshop (OpenAI-compatible) set the three variables below.
# Allowed hosts: https://api.openai.com/v1 (default) and https://api.shineshop.dev/v1
MIMI_V2_BASE_URL=https://api.shineshop.dev/v1
# Key for the custom endpoint. The OpenAI key is never sent to it.
MIMI_V2_API_KEY=your-shineshop-key
MIMI_V2_MODEL=gpt-5.6-luna
# Optional: MIMI_V2_API=responses|chat_completions, MIMI_V2_REASONING_EFFORT,
# MIMI_V2_VERBOSITY, MIMI_V2_MAX_OUTPUT_TOKENS, MIMI_V2_TIMEOUT (max 60)
# Adaptive routing (opt-in; same endpoint/key as above). Picks model + reasoning effort per flow:
# safety gpt-5.4-mini/low (uncertain -> one medium recheck), assessment gpt-5.4-mini/none,
# reply gpt-5.4-mini/low (none for listen/closing). Transient failure -> one retry on the fallback.
# On Shineshop set MIMI_V2_MODEL_* to models that endpoint serves (e.g. gpt-5.6-luna).
# MIMI_V2_ROUTING=adaptive
# Overrides: MIMI_V2_MODEL_{SAFETY,ASSESSMENT,REPLY}, MIMI_V2_EFFORT_{SAFETY,ASSESSMENT,REPLY},
# MIMI_V2_FALLBACK_MODEL (default gpt-5-mini, "off" disables), MIMI_V2_FALLBACK_EFFORT

# ============================================
# OpenAI (embeddings and default model provider)
# ============================================
OPENAI_API_KEY=sk-proj-xxxxx
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: use separate key for embedding if needed
OPENAI_API_EMBEDDING_KEY=

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string (Supabase Postgres URI)
DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_DB_URL=postgresql://user:password@supabase-host/postgres

# ============================================
# Redis Configuration
# ============================================
# Redis connection string (Upstash Redis URI - TLS recommended)
REDIS_URL=rediss://default:password@host:port
UPSTASH_REDIS_URL=rediss://default:password@host:port

# ============================================
# Email Configuration (human handoff notification)
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Sender must be a verified domain/sender on Resend
RESEND_FROM_EMAIL=Mimi Bot <noreply@yourdomain.com>
# Optional: override endpoint for proxy/self-host test
RESEND_API_BASE_URL=https://api.resend.com
# Optional: API timeout (seconds)
RESEND_REQUEST_TIMEOUT=15
EMERGENCY_EMAIL_RECIPIENTS=teacher1@gmail.com,teacher2@gmail.com
# Enable Resend diagnostics logs (request/response steps)
RESEND_DIAG=true

# ============================================
# Teacher Console (https://<your-domain>/console)
# ============================================
# The console stays disabled (HTTP 503) until ALL THREE of these are set.
CONSOLE_ADMIN_USERNAME=giaovien
# Generate with: python scripts/hash_console_password.py
CONSOLE_ADMIN_PASSWORD_HASH=pbkdf2_sha256$390000$salt_base64$hash_base64
# Random string of at least 32 chars used to sign login cookies, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
CONSOLE_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Login cookie is HTTPS-only by default; set false ONLY for local http:// testing
CONSOLE_COOKIE_SECURE=true
# Set true only when behind a trusted reverse proxy (Railway/Render): rate-limits logins per X-Forwarded-For
CONSOLE_TRUST_PROXY=false
# Facebook App ID: lets the console record replies sent by humans from Page Inbox (echo events)
FACEBOOK_APP_ID=
