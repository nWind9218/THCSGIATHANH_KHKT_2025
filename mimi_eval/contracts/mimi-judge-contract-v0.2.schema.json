          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "student",
                    "assistant",
                    "tool"
                  ]
