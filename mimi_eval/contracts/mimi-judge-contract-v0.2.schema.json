    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "lane": {
            "type": "string",
            "enum": [
              "response_quality",
              "router_policy",
              "system_actions"
            ]
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Q1",
                "Q2",
                "Q3",
                "Q4",
                "Q5",
                "Q6"
