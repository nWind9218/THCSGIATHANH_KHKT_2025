{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "mimi-judge-v0.2"
      ]
    },
    "rubric_version": {
      "type": "string",
      "enum": [
        "mimi-persona-v0.2"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "reflect",
              "offer_support",
              "clarify",
              "advise",
              "safety_intervention"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "student",
                    "assistant",
                    "tool"
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "message_id",
                "source_sha256",
                "role",
                "quote",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "evidence_refs",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "labels": {
      "type": "object",
      "properties": {
        "explicit_listen_only": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        },
        "explicit_no_questions": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        },
        "advice_requested": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        },
        "unsolicited_advice": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        },
        "response_mode_match": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        }
