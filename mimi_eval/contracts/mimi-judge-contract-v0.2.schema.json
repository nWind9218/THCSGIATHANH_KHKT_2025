    "label_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "explicit_listen_only",
              "explicit_no_questions",
              "advice_requested",
              "unsolicited_advice",
              "response_mode_match"
